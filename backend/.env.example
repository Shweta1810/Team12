PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/crm
JWT_SECRET=replace_with_a_long_random_secret

# Used only by automated tests (npm test). The database is wiped before every
# test, so keep "test" in the name and never point it at your real CRM data.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/crm_test
